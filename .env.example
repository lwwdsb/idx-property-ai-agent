# Copy to .env and fill in real values. NEVER commit .env.
# ----- MySQL (idx_exchange) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=idx_exchange

# ----- OpenAI -----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ----- Chat LLM (provider-agnostic, OpenAI-compatible /chat/completions) -----
# Empty LLM_API_KEY disables the LLM parse path; the regex fast-path still works.
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# MiniMax: LLM_BASE_URL=https://api.minimax.io/v1   LLM_MODEL=MiniMax-M2.5
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ----- WhatsApp (configured via OpenClaw; QR scan on first run) -----
# Filled in during OpenClaw skeleton setup (Week 1). Placeholder for now.
WHATSAPP_SESSION_NAME=idx-assistant

# ----- Qdrant (hybrid dense + BM25 retrieval, Week 6) -----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=listings

# ----- Warm Python retrieval service (Week 10) -----
RETRIEVAL_URL=http://localhost:8099

# ----- Email agent (Week 11) — outbound requires human approval -----
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# comma-separated operator numbers allowed to draft/approve emails
EMAIL_ALLOWLIST=
