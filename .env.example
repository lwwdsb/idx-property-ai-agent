# Copy to .env and fill in real values. NEVER commit .env.

# ----- MySQL (idx_exchange) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=idx_exchange

# ----- Chat LLM (provider-agnostic, OpenAI-compatible /chat/completions) -----
# Powers fuzzy-query parsing, RAG generation, the verifier's reasoning, and email
# polish. Empty LLM_API_KEY => graceful degrade (regex parse / extractive RAG /
# deterministic verifier / template email). Embeddings are LOCAL (fastembed
# bge-small) and need NO key.
#   DeepSeek (used here): LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat
#   OpenAI:               LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ----- WhatsApp (configured via OpenClaw; QR scan on first run) -----
WHATSAPP_SESSION_NAME=idx-assistant

# ----- Qdrant (hybrid dense + BM25 retrieval) -----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=listings

# ----- Warm Python retrieval service -----
RETRIEVAL_URL=http://localhost:8099

# ----- Orchestrate server (inbound boundary) -----
# Shared secret between the OpenClaw plugin and the orchestrate server. When set, the
# server rejects any /orchestrate call without it — so a random local process can't forge
# a request with a spoofed userId (which would bypass OpenClaw's sender auth). Generate:
#   openssl rand -hex 24     (put the same value in the gateway env: launchctl setenv ORCH_TOKEN <value>)
ORCH_TOKEN=

# ----- Email agent — outbound requires human approval -----
# Gmail: EMAIL_SMTP_HOST=smtp.gmail.com, port 587, EMAIL_PASSWORD = a 16-char App
# Password (needs 2FA; a managed Workspace account may have it disabled by an admin).
# Empty EMAIL_* => dry-run (drafts marked sent but not delivered).
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# comma-separated operator numbers allowed to draft/approve emails
EMAIL_ALLOWLIST=

# ----- Google Maps (proximity/commute filtering) -----
# Empty => proximity filtering skipped (search still works, no commute ranking).
GOOGLE_MAPS_API_KEY=
