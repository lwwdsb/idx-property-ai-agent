# ─────────────────────────────────────────────────────────────
# Secrets & credentials
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# OpenClaw gateway token / local config (if copied into repo)
openclaw.json

# ─────────────────────────────────────────────────────────────
# Confidential IDX data
# ─────────────────────────────────────────────────────────────
# NOTE: .gitignore does NOT support trailing/inline comments — keep comments on their own line.
*.sql
*.csv
*.tsv
*.dump
# confidential handbook / docs — never commit
*.pdf
data/
exports/
# cached vector files can be large + derived from MLS data
embeddings/
# Exception: schema DDL (index/table definitions) is code, not data — keep it.
!schema/*.sql

# ─────────────────────────────────────────────────────────────
# Local-only dirs (not part of the project)
# ─────────────────────────────────────────────────────────────
.claude/
slack-mcp-plugin/

# ─────────────────────────────────────────────────────────────
# WhatsApp / OpenClaw session + auth state (login credentials — never commit)
# ─────────────────────────────────────────────────────────────
.wwebjs_auth/
.wwebjs_cache/
.openclaw/
.openclaw-*/
*-auth/
session/

# ─────────────────────────────────────────────────────────────
# ML model caches (fastembed / huggingface / onnx)
# ─────────────────────────────────────────────────────────────
.fastembed_cache/
fastembed_cache/
**/models/
.cache/

# ─────────────────────────────────────────────────────────────
# Node.js
# ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
dist/
build/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# IDE / editor
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─────────────────────────────────────────────────────────────
# macOS / OS junk
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Logs & local scratch
# ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
scratch/
openclaw-plugin/node_modules/
